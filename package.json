{
  "name": "@uhero/feasim",
  "version": "0.1.1",
  "description": "UHERO's development feasibility model for Oahu housing policy pathways",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": "github:UHERO/feasim",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepare": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  },
  "license": "MIT"
}
